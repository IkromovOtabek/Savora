{
  "expo": {
    "name": "Savora",
    "slug": "savora-mobile",
    "owner": "otabekikromov",
    "version": "1.3.0",
    "orientation": "portrait",
    "scheme": "savora",
    "icon": "./assets/icon.png",
    "primaryColor": "#1A5FE0",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uz.savora.app",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "uz",
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "uz.savora.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#0A1530"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-blank.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0A1122",
          "dark": {
            "backgroundColor": "#0A1122"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Shtrix kodni skanerlash va mahsulot rasmini olish uchun kameradan foydalaniladi.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Mahsulot rasmini galereyadan tanlash uchun rasmlarga ruxsat kerak.",
          "cameraPermission": "Shtrix kodni skanerlash va mahsulot rasmini olish uchun kameradan foydalaniladi.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://savora.uz",
      "router": {},
      "eas": {
        "projectId": "a4fc9249-18d5-4304-9387-348a62ec1cf9"
      }
    }
  }
}
