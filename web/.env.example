# MongoDB klaster (master va barcha tenant bazalari shu klasterda)
MONGO_URI=mongodb://127.0.0.1:27017
MASTER_DB_NAME=savora

# Sessiya (kamida 32 belgi)
SESSION_SECRET=savdopro-super-secret-change-this-32chars

# Asosiy domen
# Lokal dev: lvh.me (dokon1.lvh.me:3000 → localhost ga ishora qiladi)
# Production: savora.uz
ROOT_DOMAIN=lvh.me
NEXT_PUBLIC_ROOT_DOMAIN=lvh.me

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_USE_PATH_ROUTING=true

# ── PRODUCTION (savora.uz) ──────────────────────────────────
# Bu qiymatlarni serverda o'rnating (yoki .env.production faylida):
#   ROOT_DOMAIN=savora.uz
#   NEXT_PUBLIC_ROOT_DOMAIN=savora.uz
#   NODE_ENV=production
#   NEXT_PUBLIC_APP_URL=https://savora.uz
#   NEXT_PUBLIC_USE_PATH_ROUTING=true   # bitta domen + path (savora.uz/super, /t/<slug>)

# Cron (obuna muddati + Daftar eslatmalari)
CRON_SECRET=your-cron-secret-here
# Kunlik daftar eslatmasi (egaga Telegram, do'stga SMS):
#   curl -H "Authorization: Bearer <CRON_SECRET>" "https://savora.uz/api/cron/daftar-reminders"  (production: ?secret= ishlamaydi)
# (obuna eslatmasi bilan bir xil jadval — har kuni bir marta)

# SMS — Eskiz.uz (Daftar qarz eslatmalari uchun; bo'sh bo'lsa SMS yuborilmaydi)
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# Telegram (ixtiyoriy)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Bot foydalanuvchi nomi (@ siz) — Telegram ulash havolasi va parol tiklash uchun
TELEGRAM_BOT_USERNAME=
# Webhook maxfiy kaliti (majburiy, production'da bo'lmasa webhook barcha so'rovni rad etadi).
# Yaratish: openssl rand -hex 32   (faqat A-Z a-z 0-9 _ - belgilar, 1–256 uzunlik)
TELEGRAM_WEBHOOK_SECRET=
# Webhook'ni o'rnatish (secret_token bilan — Telegram uni har so'rovda sarlavhada yuboradi):
#   curl -X POST "https://api.telegram.org/bot<TOKEN>/setWebhook" \
#     -d "url=https://savora.uz/api/telegram/webhook" -d "secret_token=<TELEGRAM_WEBHOOK_SECRET>"
# Mini App (Telegram ichidagi ilova): NEXT_PUBLIC_APP_URL/tg manzili.
#   BotFather → /setmenubutton (yoki /newapp) → URL: https://savora.uz/tg
#   Foydalanuvchi: Kabinet → "Telegram hisobini bog'lash" → botda Start → "Savora'ni ochish".

# Cloudflare R2 — fayl/rasm saqlash (ixtiyoriy; bo'sh bo'lsa lokal public/uploads ishlatiladi)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=savora-uploads
R2_PUBLIC_URL=https://cdn.savora.uz

# Zaxira (backup) — mongodump topilgan bo'lishi kerak. Saqlash joyi (ixtiyoriy)
BACKUP_DIR=./backups

# ── Monitoring / xavfsizlik (ixtiyoriy) ─────────────────────
# Xatolar shu manzilga JSON POST qilinadi (Slack/Discord webhook, n8n, o'z relay'ingiz).
# Bo'sh bo'lsa — faqat log. Payload'da `text`/`content` maydoni bor (Slack/Discord mos).
ERROR_WEBHOOK_URL=
# Sentry (ixtiyoriy). Server xatolari: SENTRY_DSN. Brauzer xatolari: NEXT_PUBLIC_SENTRY_DSN (BUILD vaqtida).
# Bo'sh bo'lsa — Sentry paketi umuman yuklanmaydi.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0
# Redis (ixtiyoriy): bir nechta instance (savora-a/b) bo'lsa login rate-limit umumiy bo'ladi.
# Bo'sh bo'lsa — har instance o'z xotirasida hisoblaydi. Masalan: redis://127.0.0.1:6379/0
REDIS_URL=
# CSP rejimi (BUILD vaqtida): enforce (standart) | report-only (faqat ogohlantirish) | off
CSP_MODE=enforce

# ── Docker (docker-compose.yml) ─────────────────────────────
# Konteyner ichidan bazaga manzil (standart: mongodb://mongo:27017). MONGO_URI esa host'dagi
# skriptlar (backup) uchun qoladi: mongodb://127.0.0.1:27017
# MONGO_URI_DOCKER=mongodb://mongo:27017
# MongoDB xotira keshi (GB) — kichik VPS'da 0.5
# MONGO_CACHE_GB=0.5
# APP_VERSION / APP_IMAGE — deploy/deploy.sh avtomatik qo'yadi

# AI yordamchi (/app/ai) — Anthropic Claude (ixtiyoriy; bo'sh bo'lsa qoidalar asosida tahlil ishlaydi)
# Kalit: https://console.anthropic.com → API Keys. Batafsil: docs/AI.md
ANTHROPIC_API_KEY=
# Model (bo'sh = claude-sonnet-5-5)
ANTHROPIC_MODEL=

# Mobil ilova yuklab olish havolalari (landing «#ilova» bo'limi). Bo'sh bo'lsa — «Tez kunda».
#   MOBILE_ANDROID_URL=https://savora.uz/download/savora.apk
#   MOBILE_IOS_URL=https://testflight.apple.com/join/XXXXXXXX
MOBILE_ANDROID_URL=
MOBILE_IOS_URL=
